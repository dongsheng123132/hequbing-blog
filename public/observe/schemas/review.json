{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "expectedProposalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    }
  },
  "required": [
    "proposalId",
    "expectedProposalVersion",
    "decision",
    "note"
  ],
  "additionalProperties": false
}
